# Server Configuration
PORT=3000
HOST=0.0.0.0

# Optional API key to protect your proxy when exposed publicly
# If set, clients must provide header: Authorization: Bearer <PROXY_API_KEY>
PROXY_API_KEY=

# Optional Free-PI JWT token (if empty, automatically reads from ~/.free-pi/agent/credentials.json)
FREEPI_TOKEN=

# Persistent Session ID (prevents 409 concurrent_session limit)
# If empty, automatically managed and stored in .session-id
# FREEPI_SESSION_ID=
# FREEPI_SESSION_FILE=.session-id

# Free-PI Backend Configuration
FREEPI_BASE_URL=https://api.freepi.ai
FREEPI_CLIENT_VERSION=0.6.23
