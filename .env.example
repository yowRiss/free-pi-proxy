# Port proxy server
PORT=3000
HOST=0.0.0.0

# Kunci API untuk mengamankan proxy ini saat diakses publik (opsional)
# Jika diisi, klien harus mengirimkan header: Authorization: Bearer <PROXY_API_KEY>
PROXY_API_KEY=

# Token Free-PI (opsional, jika kosong akan otomatis membaca dari ~/.free-pi/agent/credentials.json)
FREEPI_TOKEN=

# Free-PI Backend Base URL
FREEPI_BASE_URL=https://api.freepi.ai
FREEPI_CLIENT_VERSION=0.6.23
